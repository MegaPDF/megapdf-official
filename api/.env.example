# Basic Configuration
DEBUG=true
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Application Settings
SITE_NAME=MegaPDF Social
SITE_DESCRIPTION=Social Network Platform with PDF Processing
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Database Configuration
# SQLite (default)
DB_PATH=data/megapdf.db

# MongoDB (optional)
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=megapdf_social

# Redis (optional)
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS S3 Configuration (optional)
S3_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=your-bucket-name
S3_ENDPOINT=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=true
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=MegaPDF Social

# Security Settings
REQUIRE_EMAIL_VERIFICATION=true
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
SESSION_TIMEOUT=7200
MAX_LOGIN_ATTEMPTS=5

# File Upload Settings
MAX_FILE_SIZE=104857600
UPLOAD_DIR=uploads
PUBLIC_DIR=public
TEMP_DIR=temp

# Platform Settings
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
RATE_LIMIT_REQUESTS=100
LOGGING_ENABLED=true
LOG_LEVEL=info

# OAuth Settings (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# PayPal Settings (optional)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com